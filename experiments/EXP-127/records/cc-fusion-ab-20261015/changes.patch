-        crplan->length    = outputLength;
-        crplan->dimension = 1;
-        crplan->RecursiveBuildTree((noSolution) ? nullptr : child_scheme_trees[2].get());
-        childNodes.emplace_back(std::move(crplan));
-
-        // --------------------------------
-        // Fuse Shims:
