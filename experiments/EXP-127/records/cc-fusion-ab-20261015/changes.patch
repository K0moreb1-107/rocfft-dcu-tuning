-    if((pre && (inArrayType != rocfft_array_type_hermitian_interleaved
-                || outArrayType != rocfft_array_type_real))
-       || (!pre && (direction != -1 || inArrayType != rocfft_array_type_real
-                    || outArrayType != rocfft_array_type_hermitian_interleaved)))
-        return false;
