-       || inStride != std::vector<size_t>{1} || outStride != std::vector<size_t>{1}
-       || rootHasUserOffsets || iOffset != 0 || oOffset != 0 || !is_device_gcn_arch(deviceProp, "gfx936")
-       || cfft.scheme != CS_BLUESTEIN || cfft.typeBlue != BT_MULTI_KERNEL
