+            entry=dict(item,returncode=0,gpu=gpu,job_id='synthetic',host='synthetic',
+                       library_sha256=m['arms'][item['arm']]['library_sha256'])
+            for key,name in [('csv','summary.csv'),('samples','samples.csv'),('correctness','check.csv'),
